{
  "name": "claude-panel",
  "displayName": "Claude Panel (personal)",
  "description": "Conversation-first Claude Code panel: subagent tabs, LaTeX rendering, full status bar.",
  "version": "0.1.0",
  "publisher": "david-local",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "vscode": "^1.94.0"
  },
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:claudePanel.chat"
  ],
  "contributes": {
    "commands": [
      {
        "command": "claudePanel.newSession",
        "title": "New Session",
        "category": "Claude Panel",
        "icon": "$(add)"
      },
      {
        "command": "claudePanel.openSession",
        "title": "Open Previous Session…",
        "category": "Claude Panel",
        "icon": "$(history)"
      },
      {
        "command": "claudePanel.refreshSessions",
        "title": "Refresh Sessions",
        "category": "Claude Panel",
        "icon": "$(refresh)"
      },
      {
        "command": "claudePanel.toggleMath",
        "title": "Toggle Math Rendering",
        "category": "Claude Panel"
      },
      {
        "command": "claudePanel.checkForUpdates",
        "title": "Check for Claude Code Updates",
        "category": "Claude Panel"
      },
      {
        "command": "claudePanel.showLog",
        "title": "Show Log",
        "category": "Claude Panel"
      },
      {
        "command": "claudePanel.renameSession",
        "title": "Rename Session…",
        "category": "Claude Panel",
        "icon": "$(edit)"
      },
      {
        "command": "claudePanel.forkSession",
        "title": "Fork Session",
        "category": "Claude Panel",
        "icon": "$(repo-forked)"
      },
      {
        "command": "claudePanel.deleteSession",
        "title": "Delete Session…",
        "category": "Claude Panel",
        "icon": "$(trash)"
      },
      {
        "command": "claudePanel.agentMap",
        "title": "Show Agent Map",
        "category": "Claude Panel",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "claudePanel.signIn",
        "title": "Sign In to Claude",
        "category": "Claude Panel"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudePanel",
          "title": "Claude Panel",
          "icon": "resources/activity.svg"
        }
      ]
    },
    "views": {
      "claudePanel": [
        {
          "id": "claudePanel.sessions",
          "name": "Sessions"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "claudePanel.newSession",
          "when": "view == claudePanel.sessions",
          "group": "navigation@1"
        },
        {
          "command": "claudePanel.refreshSessions",
          "when": "view == claudePanel.sessions",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "claudePanel.renameSession",
          "when": "view == claudePanel.sessions && viewItem == session",
          "group": "inline@1"
        },
        {
          "command": "claudePanel.forkSession",
          "when": "view == claudePanel.sessions && viewItem == session",
          "group": "1_session@2"
        },
        {
          "command": "claudePanel.renameSession",
          "when": "view == claudePanel.sessions && viewItem == session",
          "group": "1_session@1"
        },
        {
          "command": "claudePanel.deleteSession",
          "when": "view == claudePanel.sessions && viewItem == session",
          "group": "9_delete@1"
        }
      ],
      "editor/title": [
        {
          "command": "claudePanel.agentMap",
          "when": "activeWebviewPanelId == claudePanel.chat",
          "group": "navigation@1"
        },
        {
          "command": "claudePanel.renameSession",
          "when": "activeWebviewPanelId == claudePanel.chat",
          "group": "1_session@1"
        },
        {
          "command": "claudePanel.forkSession",
          "when": "activeWebviewPanelId == claudePanel.chat",
          "group": "1_session@2"
        },
        {
          "command": "claudePanel.deleteSession",
          "when": "activeWebviewPanelId == claudePanel.chat",
          "group": "9_delete@1"
        }
      ]
    },
    "configuration": {
      "title": "Claude Panel",
      "properties": {
        "claudePanel.renderMath": {
          "type": "boolean",
          "default": true,
          "description": "Render LaTeX ($…$, $$…$$, \\(…\\), \\[…\\]) with KaTeX. Off shows the LaTeX source."
        },
        "claudePanel.toolActivity": {
          "type": "string",
          "enum": [
            "hidden",
            "summary",
            "detailed"
          ],
          "default": "summary",
          "description": "How much of Claude's tool activity to show between messages."
        },
        "claudePanel.showThinking": {
          "type": "boolean",
          "default": false,
          "description": "Show Claude's thinking blocks (when the model returns them)."
        },
        "claudePanel.enterToSend": {
          "type": "boolean",
          "default": true,
          "description": "Enter sends (Shift+Enter for a newline). Off: Ctrl+Enter sends."
        },
        "claudePanel.initialModel": {
          "type": "string",
          "default": "",
          "description": "Model for new sessions (e.g. opus, sonnet, claude-fable-5-1). Empty: your Claude Code default.",
          "scope": "application"
        },
        "claudePanel.initialPermissionMode": {
          "type": "string",
          "enum": [
            "",
            "default",
            "acceptEdits",
            "plan",
            "auto"
          ],
          "default": "",
          "description": "Permission mode for new sessions. Empty: your Claude Code default.",
          "scope": "application"
        },
        "claudePanel.remoteControl": {
          "type": "string",
          "enum": [
            "auto",
            "on",
            "off"
          ],
          "default": "auto",
          "description": "Turn on remote control when a session starts. auto: follow remoteControlAtStartup in ~/.claude/settings.json.",
          "scope": "application"
        },
        "claudePanel.prewarm": {
          "type": "boolean",
          "default": true,
          "description": "Keep one Claude Code process started in the background so new sessions open fast.",
          "scope": "application"
        },
        "claudePanel.checkForUpdates": {
          "type": "boolean",
          "default": true,
          "description": "Check npm for newer Claude Code releases at startup.",
          "scope": "application"
        },
        "claudePanel.claudeExecutable": {
          "type": "string",
          "default": "",
          "description": "Path to a claude.exe to use instead of the bundled one.",
          "scope": "machine"
        },
        "claudePanel.mathMacros": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "markdownDescription": "Extra KaTeX macros, e.g. `{\"\\Gal\": \"\\operatorname{Gal}\"}`. Built in: `F`, `Q`, `C`, `E` as blackboard bold."
        },
        "claudePanel.sound": {
          "type": "string",
          "enum": [
            "needsYou",
            "needsYouAndDone",
            "off"
          ],
          "enumDescriptions": [
            "When Claude or a subagent needs your answer",
            "Also when Claude finishes",
            "Never"
          ],
          "default": "needsYou",
          "description": "Play a sound (only when you are not looking at the panel). Your own Stop hook already plays a sound when Claude finishes."
        },
        "claudePanel.notification": {
          "type": "string",
          "enum": [
            "needsYou",
            "needsYouAndDone",
            "off"
          ],
          "enumDescriptions": [
            "When Claude or a subagent needs your answer",
            "Also when Claude finishes",
            "Never"
          ],
          "default": "needsYouAndDone",
          "description": "Show a VS Code notification (only when you are not looking at the panel)."
        },
        "claudePanel.soundNeedsYou": {
          "type": "string",
          "default": "",
          "description": "A .wav file for \"needs you\". Empty: Windows Notify Messaging.",
          "scope": "application"
        },
        "claudePanel.soundDone": {
          "type": "string",
          "default": "",
          "description": "A .wav file for \"finished\". Empty: Windows chimes.",
          "scope": "application"
        }
      }
    }
  },
  "scripts": {
    "test": "npm run -s replay && npm run -s unit && npm run -s test-md",
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "replay": "esbuild test/replay.ts --bundle --platform=node --format=esm --outfile=.test/replay.mjs --log-level=warning && node .test/replay.mjs",
    "package": "node build.mjs --production && node test/smoke.cjs && vsce package --no-dependencies --skip-license --allow-missing-repository -o claude-panel.vsix",
    "test-md": "esbuild test/markdown.ts --bundle --platform=node --format=esm --outfile=.test/markdown.mjs --log-level=warning && node .test/markdown.mjs",
    "e2e": "esbuild test/e2e.ts --bundle --platform=node --format=esm --outfile=.test/e2e.mjs --log-level=warning --alias:vscode=./test/mock-vscode.ts --external:@anthropic-ai/claude-agent-sdk && node .test/e2e.mjs",
    "harness": "esbuild test/harness.ts --bundle --platform=node --format=esm --outfile=.test/harness.mjs --log-level=warning --external:@anthropic-ai/claude-agent-sdk && node .test/harness.mjs",
    "unit": "esbuild test/unit.ts --bundle --platform=node --format=esm --outfile=.test/unit.mjs --log-level=warning && node .test/unit.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.282",
    "katex": "^0.18.9",
    "markdown-it": "^15.0.2",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/vscode": "1.94",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Sensitive settings (which claude.exe to run, permission mode, remote control) are only read from your user settings.",
      "restrictedConfigurations": [
        "claudePanel.claudeExecutable",
        "claudePanel.initialPermissionMode",
        "claudePanel.remoteControl"
      ]
    }
  }
}
