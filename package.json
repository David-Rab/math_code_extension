{
  "name": "mathpanel",
  "displayName": "MathPanel (unofficial)",
  "description": "Unofficial conversation-first panel for Claude Code: subagent tabs, LaTeX rendering, status bar. Not affiliated with Anthropic.",
  "version": "0.2.283",
  "publisher": "david-local",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "vscode": "^1.94.0"
  },
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:claudePanel.chat"
  ],
  "contributes": {
    "commands": [
      {
        "command": "claudePanel.newSession",
        "title": "New Session",
        "category": "MathPanel",
        "icon": "$(add)"
      },
      {
        "command": "claudePanel.newSessionTab",
        "title": "New MathPanel Session",
        "category": "MathPanel",
        "icon": "resources/icon.svg"
      },
      {
        "command": "claudePanel.openSession",
        "title": "Open Previous Session…",
        "category": "MathPanel",
        "icon": "$(history)"
      },
      {
        "command": "claudePanel.refreshSessions",
        "title": "Refresh Sessions",
        "category": "MathPanel",
        "icon": "$(refresh)"
      },
      {
        "command": "claudePanel.toggleMath",
        "title": "Toggle Math Rendering",
        "category": "MathPanel"
      },
      {
        "command": "claudePanel.checkForUpdates",
        "title": "Check for Claude Code Updates",
        "category": "MathPanel"
      },
      {
        "command": "claudePanel.showLog",
        "title": "Show Log",
        "category": "MathPanel"
      },
      {
        "command": "claudePanel.renameSession",
        "title": "Rename Session…",
        "category": "MathPanel",
        "icon": "$(edit)"
      },
      {
        "command": "claudePanel.forkSession",
        "title": "Fork Session",
        "category": "MathPanel",
        "icon": "$(repo-forked)"
      },
      {
        "command": "claudePanel.deleteSession",
        "title": "Delete Session…",
        "category": "MathPanel",
        "icon": "$(trash)"
      },
      {
        "command": "claudePanel.agentMap",
        "title": "Show Agent Map",
        "category": "MathPanel",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "claudePanel.signIn",
        "title": "Sign In to Claude",
        "category": "MathPanel"
      },
      {
        "command": "claudePanel.reportProblem",
        "title": "Report a Problem…",
        "category": "MathPanel",
        "icon": "$(report)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudePanel",
          "title": "MathPanel",
          "icon": "resources/activity.svg"
        }
      ]
    },
    "views": {
      "claudePanel": [
        {
          "id": "claudePanel.sessions",
          "name": "Sessions"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "claudePanel.newSession",
          "when": "view == claudePanel.sessions",
          "group": "navigation@1"
        },
        {
          "command": "claudePanel.refreshSessions",
          "when": "view == claudePanel.sessions",
          "group": "navigation@2"
        },
        {
          "command": "claudePanel.reportProblem",
          "when": "view == claudePanel.sessions",
          "group": "9_report@1"
        }
      ],
      "view/item/context": [
        {
          "command": "claudePanel.renameSession",
          "when": "view == claudePanel.sessions && viewItem == session",
          "group": "inline@1"
        },
        {
          "command": "claudePanel.forkSession",
          "when": "view == claudePanel.sessions && viewItem == session",
          "group": "1_session@2"
        },
        {
          "command": "claudePanel.renameSession",
          "when": "view == claudePanel.sessions && viewItem == session",
          "group": "1_session@1"
        },
        {
          "command": "claudePanel.deleteSession",
          "when": "view == claudePanel.sessions && viewItem == session",
          "group": "9_delete@1"
        }
      ],
      "commandPalette": [
        {
          "command": "claudePanel.newSessionTab",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "claudePanel.newSessionTab",
          "group": "navigation@90"
        },
        {
          "command": "claudePanel.agentMap",
          "when": "activeWebviewPanelId == claudePanel.chat",
          "group": "navigation@1"
        },
        {
          "command": "claudePanel.renameSession",
          "when": "activeWebviewPanelId == claudePanel.chat",
          "group": "1_session@1"
        },
        {
          "command": "claudePanel.forkSession",
          "when": "activeWebviewPanelId == claudePanel.chat",
          "group": "1_session@2"
        },
        {
          "command": "claudePanel.deleteSession",
          "when": "activeWebviewPanelId == claudePanel.chat",
          "group": "9_delete@1"
        },
        {
          "command": "claudePanel.reportProblem",
          "when": "activeWebviewPanelId == claudePanel.chat",
          "group": "8_report@1"
        }
      ]
    },
    "configuration": {
      "title": "MathPanel",
      "properties": {
        "claudePanel.renderMath": {
          "type": "boolean",
          "default": true,
          "description": "Render LaTeX ($…$, $$…$$, \\(…\\), \\[…\\]) with KaTeX. Off shows the LaTeX source."
        },
        "claudePanel.toolActivity": {
          "type": "string",
          "enum": [
            "hidden",
            "summary",
            "detailed"
          ],
          "default": "summary",
          "description": "How much of Claude's tool activity to show between messages."
        },
        "claudePanel.showThinking": {
          "type": "boolean",
          "default": false,
          "description": "Show Claude's thinking blocks (when the model returns them)."
        },
        "claudePanel.enterToSend": {
          "type": "boolean",
          "default": true,
          "description": "Enter sends (Shift+Enter for a newline). Off: Ctrl+Enter sends."
        },
        "claudePanel.initialModel": {
          "type": "string",
          "default": "",
          "description": "Always start new sessions with this model (e.g. opus, sonnet, claude-fable-5-1). Empty: the model you last picked in a panel, else your Claude Code default.",
          "scope": "application"
        },
        "claudePanel.initialPermissionMode": {
          "type": "string",
          "enum": [
            "",
            "default",
            "acceptEdits",
            "plan",
            "auto"
          ],
          "default": "",
          "description": "Always start new sessions in this permission mode. Empty: the mode you last picked in a panel, else your Claude Code default.",
          "scope": "application"
        },
        "claudePanel.remoteControl": {
          "type": "string",
          "enum": [
            "auto",
            "on",
            "off"
          ],
          "default": "auto",
          "description": "Turn on remote control when a session starts. auto: follow remoteControlAtStartup in ~/.claude/settings.json.",
          "scope": "application"
        },
        "claudePanel.prewarm": {
          "type": "boolean",
          "default": true,
          "description": "Keep one Claude Code process started in the background so new sessions open fast.",
          "scope": "application"
        },
        "claudePanel.checkForUpdates": {
          "type": "boolean",
          "default": true,
          "description": "Check npm for newer Claude Code releases at startup.",
          "scope": "application"
        },
        "claudePanel.claudeExecutable": {
          "type": "string",
          "default": "",
          "description": "Path to a claude.exe to use instead of the bundled one.",
          "scope": "machine"
        },
        "claudePanel.mathMacros": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "markdownDescription": "Extra KaTeX macros, e.g. `{\"\\Gal\": \"\\operatorname{Gal}\"}`. Built in: `F`, `Q`, `C`, `E` as blackboard bold.",
          "scope": "application"
        },
        "claudePanel.sound": {
          "type": "string",
          "enum": [
            "needsYou",
            "needsYouAndDone",
            "off"
          ],
          "enumDescriptions": [
            "When Claude or a subagent needs your answer",
            "Also when Claude finishes",
            "Never"
          ],
          "default": "needsYou",
          "description": "Play a sound (only when you are not looking at the panel). Your own Stop hook already plays a sound when Claude finishes.",
          "scope": "application"
        },
        "claudePanel.notification": {
          "type": "string",
          "enum": [
            "needsYou",
            "needsYouAndDone",
            "off"
          ],
          "enumDescriptions": [
            "When Claude or a subagent needs your answer",
            "Also when Claude finishes",
            "Never"
          ],
          "default": "needsYouAndDone",
          "description": "Show a VS Code notification (only when you are not looking at the panel).",
          "scope": "application"
        },
        "claudePanel.soundNeedsYou": {
          "type": "string",
          "default": "",
          "description": "A .wav file for \"needs you\". Empty: Windows Notify Messaging.",
          "scope": "application"
        },
        "claudePanel.soundDone": {
          "type": "string",
          "default": "",
          "description": "A .wav file for \"finished\". Empty: Windows chimes.",
          "scope": "application"
        }
      }
    }
  },
  "scripts": {
    "test": "npm run -s replay && npm run -s unit && npm run -s host && npm run -s test-md",
    "host": "esbuild test/host.ts --bundle --platform=node --format=esm --outfile=.test/host.mjs --log-level=warning --alias:vscode=./test/mock-vscode.ts --external:@anthropic-ai/claude-agent-sdk && node .test/host.mjs",
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "replay": "esbuild test/replay.ts --bundle --platform=node --format=esm --outfile=.test/replay.mjs --log-level=warning && node .test/replay.mjs",
    "package": "node scripts/sync-version.mjs && node build.mjs --production && node test/smoke.cjs && vsce package --no-dependencies --ignoreFile .vscodeignore.generated -o mathpanel.vsix",
    "test-md": "esbuild test/markdown.ts --bundle --platform=node --format=esm --outfile=.test/markdown.mjs --log-level=warning && node .test/markdown.mjs",
    "e2e": "esbuild test/e2e.ts --bundle --platform=node --format=esm --outfile=.test/e2e.mjs --log-level=warning --alias:vscode=./test/mock-vscode.ts --external:@anthropic-ai/claude-agent-sdk && node .test/e2e.mjs",
    "harness": "esbuild test/harness.ts --bundle --platform=node --format=esm --outfile=.test/harness.mjs --log-level=warning --external:@anthropic-ai/claude-agent-sdk && node .test/harness.mjs",
    "unit": "esbuild test/unit.ts --bundle --platform=node --format=esm --outfile=.test/unit.mjs --log-level=warning && node .test/unit.mjs",
    "trust-e2e": "esbuild test/trust-e2e.ts --bundle --platform=node --format=esm --outfile=.test/trust-e2e.mjs --log-level=warning --alias:vscode=./test/mock-vscode.ts --external:@anthropic-ai/claude-agent-sdk && node .test/trust-e2e.mjs",
    "prepare": "node scripts/install-hooks.mjs",
    "check-privacy": "node scripts/privacy-check.mjs",
    "precommit": "npm run typecheck && npm test && node scripts/privacy-check.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.283",
    "katex": "^0.18.9",
    "markdown-it": "^15.0.2",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/vscode": "1.94",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Sensitive settings (which claude.exe to run, permission mode, remote control) are only read from your user settings.",
      "restrictedConfigurations": [
        "claudePanel.claudeExecutable",
        "claudePanel.initialPermissionMode",
        "claudePanel.remoteControl"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/David-Rab/math_code_extension"
  }
}
